APP_NAME=Millet Milk Sales AI
APP_VERSION=1.0.0

BUSINESS_NAME=Millet Milk Sales

CURRENCY=INR

DELIVERY_MODES=home_delivery,pickup

PAYMENT_MODES=cash_on_delivery,upi

ENVIRONMENT=development

API_PREFIX=/api/v1

# Required to enable admin account signup. Generate a unique, long random key.
ADMIN_SIGNUP_KEY=

# Required for the external delivery provider to post tracking updates.
TRACKING_WEBHOOK_SECRET=

# WhatsApp Configuration
WHATSAPP_ACCESS_TOKEN=YOUR_ACCESS_TOKEN

WHATSAPP_PHONE_NUMBER_ID=YOUR_PHONE_NUMBER_ID

WHATSAPP_BUSINESS_ACCOUNT_ID=YOUR_WABA_ID

WHATSAPP_APP_SECRET=YOUR_META_APP_SECRET

WHATSAPP_VERIFY_TOKEN=millet_milk_webhook_secret_2026

WHATSAPP_API_VERSION=vXX.0

REDIS_URL: str = "redis://localhost:6379/0"
REDIS_CACHE_TTL: int = 300
REDIS_SESSION_TTL: int = 1800
REDIS_ENABLED: bool = True